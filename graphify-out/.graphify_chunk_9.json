  "patterns": [
    {
      "type": "architectural_pattern",
      "name": "Three-Layer Prediction Stack",
      "description": "Statistical methods (MA, LR, ES) + Fundamental model (crude oil, FX, weekday) + AI (geopolitical risk) combined via data-quality-aware ensemble"
    },
    {
      "type": "data_flow",
      "name": "Live-Only Data Pipeline",
      "description": "All data is live-scraped from today forward; no synthetic/interpolated/historical data; daily_tracker is ground truth"
    },
    {
      "type": "safety_pattern",
      "name": "Multi-Layer Price Verification",
      "description": "Hard bounds (1.10-3.50 EUR/L) + historical deviation check (20% threshold) + daily change limit (0.15 EUR/L) + cross-fuel reasonableness"
    },
    {
      "type": "scraper_strategy",
      "name": "Dual-Source with Priority",
      "description": "tankille.fi is PRIMARY (per-city, tested accurate); polttoaine.net is SECONDARY (top-20 national, cross-check); fall back if >10% price divergence"
    },
    {
      "type": "prediction_clamp",
      "name": "Breaking News Severity Multiplier",
      "description": "Base clamp ±0.06 EUR/L; severity 1-3 → 1.33x, severity 4-6 → 1.67x, severity 7-10 → 2.50x; prevents over-reaction to speculation"
    },
    {
      "type": "self_training",
      "name": "Bias-Aware Calibration",
      "description": "Each method tracks signed prediction error (bias); fundamental_anchor applies damped correction (-bias * min(n/25, 1), max ±0.02); ensemble weights by 1/MAE"
    },
    {
      "type": "notification_format",
      "name": "Multi-Fuel City Summary",
      "description": "ASCII title for HTTP header compatibility; UTF-8 body with fuel sections, city blocks, station details, source comparison (polttoaine.net vs tankille.fi)"
    },
    {
      "type": "cold_start_tolerance",
      "name": "Graceful Degradation",
      "description": "Predictions work from 0 data points: live anchor + fundamental model; statistical methods degrade to simpler forms; ensemble shifts weight to anchor + AI"
    },
    {
      "type": "ai_prompt_structure",
      "name": "9-Principle Uncalibrated Prior System",
      "description": "AI system message explicitly labels all priors as UNCALIBRATED; includes lag-pikes (t-1, t-2, t-3, t-7), refined product > Brent priority, geopolitics split (priced vs forward risk)"
    },
    {
      "type": "date_awareness",
      "name": "Calendar-Day Projections",
      "description": "All methods project +1 calendar day (not index); MA/LR/ES use daily_tail (max 3-day gap); prevents month-boundary artifacts"
    }
  ],
