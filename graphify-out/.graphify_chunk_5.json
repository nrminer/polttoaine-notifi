  "concepts": [
    {
      "id": "live_data_only_architecture",
      "name": "Live Data Only Architecture",
      "description": "All price data is live-scraped from today onwards. No synthetic, interpolated, or Tilastokeskus (Statfin) historical data. Legacy modeled data has been purged.",
      "related_entities": ["mongodb_history", "mongodb_daily_tracker", "server.py", "tracker.py"]
    },
    {
      "id": "dual_scraper_strategy",
      "name": "Dual Scraper with Priority",
      "description": "Two scrapers (polttoaine.net and tankille.fi) with tankille.fi as PRIMARY source. Fallback to polttoaine.net when tankille is >10% higher. Both filtered through sanity checks.",
      "related_entities": ["polttoaine_scraper", "tankille_scraper", "sanity_filter", "server.py", "notify.py"]
    },
    {
      "id": "five_method_prediction",
      "name": "Five Parallel Prediction Methods",
      "description": "MA, LR, Exp Smoothing, Fundamental Anchor, and AI LLM run in parallel, then combined via data-quality-aware ensemble with self-calibrating weights.",
      "related_entities": ["predict.py", "moving_average_method", "linear_regression_method", "exp_smoothing_method", "fundamental_anchor_method", "ai_llm_method", "ensemble_method"]
    },
    {
      "id": "scheduled_capture_system",
      "name": "Scheduled Capture System",
      "description": "Automated captures at 14:00 and 21:00 Helsinki time. Each capture scrapes actual prices, loads yesterday's prediction for accuracy tracking, and generates fresh prediction for tomorrow.",
      "related_entities": ["tracker.py", "mongodb_daily_tracker", "capture_now_script"]
    },
    {
      "id": "self_training_loop",
      "name": "Self-Training Loop",
      "description": "System learns from its own prediction errors. Fundamental anchor applies bias correction, AI sees its track record, ensemble weights calibrate to realized MAE.",
      "related_entities": ["learn.py", "bias_correction", "fundamental_anchor_method", "ai_llm_method", "ensemble_method"]
    },
    {
      "id": "fundamental_factors",
      "name": "Fundamental Market Factors",
      "description": "Live market data feeding predictions: Brent crude, EUR/USD, refined products (RBOB/ULSD), crack spreads, weekday effects, momentum, and known tax events.",
      "related_entities": ["factors.py", "fundamental_anchor_method", "tax_events.py"]
    },
    {
      "id": "geopolitical_risk_detection",
      "name": "Geopolitical Risk Detection",
      "description": "News scanner detects conflict/supply disruption keywords. AI handles forward-looking risk, while Brent already prices historical risk (no double-counting).",
      "related_entities": ["news.py", "conflict_scanner", "ai_llm_method"]
    },
    {
      "id": "data_quality_awareness",
      "name": "Data Quality Awareness",
      "description": "Prediction system adapts to thin vs. rich daily data. Thin data (<14 daily points) → lean on fundamental_anchor + AI. Rich data → balance all methods.",
      "related_entities": ["ensemble_method", "predict.py", "mongodb_daily_tracker"]
    },
    {
      "id": "price_clamping",
      "name": "Price Clamping Safety",
      "description": "Predictions clamped to ±0.06 EUR/L of live price (expanded by tax step amount when applicable). Prevents unrealistic jumps.",
      "related_entities": ["fundamental_anchor_method", "ensemble_method", "predict.py"]
    },
    {
      "id": "ntfy_notification_system",
      "name": "ntfy.sh Notification System",
      "description": "Push notifications sent at each capture with multi-fuel summary. Shows cheapest per city with cross-source validation.",
      "related_entities": ["notify.py", "tracker.py", "server.py"]
    },
    {
      "id": "date_aware_algorithms",
      "name": "Date-Aware Statistical Algorithms",
      "description": "MA/LR/ES use calendar day projections (+1 day) and daily tail extraction to avoid treating sparse data as daily frequency.",
      "related_entities": ["moving_average_method", "linear_regression_method", "exp_smoothing_method", "predict.py"]
    },
    {
      "id": "worktree_architecture",
      "name": "Agent Worktree Architecture",
      "description": "Multiple .claude/worktrees contain different agent iterations. agent-a9562a62d22e952b1 is current, agent-a52a5e37468629d79 is legacy.",
      "related_entities": ["check_prices_script", "polttoaine_scraper_old", "tankille_scraper_old", "settings_local"]
    }
