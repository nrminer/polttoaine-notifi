  "powershell_command": "Invoke-WebRequest -Uri \"https://polttoaine-notifi-production-fc06.up.railway.app/api/admin/run\" -Method POST -Headers @{\"Content-Type\"=\"application/json\"; \"X-Admin-Token\"=\"syDOHgw2R5HvzHxG1NPHIhIYSWy9U6zvUTqxt5Jk1U2UOwrr\"} -Body '{\"password\":\"syDOHgw2R5HvzHxG1NPHIhIYSWy9U6zvUTqxt5Jk1U2UOwrr\",\"action\":\"all\",\"fuel\":\"all\",\"notify\":true}'",
